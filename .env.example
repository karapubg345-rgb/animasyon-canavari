# Apify — Instagram linkindeki videoyu indirmek için.
# Ücretsiz hesap aç: https://apify.com  →  Settings → API & Integrations → Personal API token
# Token'ı eşittirin hemen sonrasına yapıştır, ör.  APIFY_TOKEN=apify_api_AbC123...
APIFY_TOKEN=

# İsteğe bağlı: arayüz portu (varsayılan 8765)
# ARAYUZ_PORT=8765
